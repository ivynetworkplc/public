{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivy-forms-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  // Bind D1 after: npx wrangler d1 create ivy-forms-db
  // Replace database_id with the ID printed by that command.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ivy-forms-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://ivynetwork.co.uk,https://www.ivynetwork.co.uk,http://localhost:8787,http://127.0.0.1:8787",
    "RATE_LIMIT_PER_MINUTE": "10",
    "MAX_BODY_BYTES": "32768",
    "ENVIRONMENT": "production"
  }

  // Secrets (set via: npx wrangler secret put NAME)
  // ADMIN_API_KEY — optional key for future admin list endpoints
  // EMAIL_API_KEY — optional provider API key (Resend / SendGrid / etc.)
  // EMAIL_FROM — e.g. forms@ivynetwork.co.uk
  // EMAIL_TO — e.g. team@ivynetwork.co.uk
  // EMAIL_PROVIDER — resend | sendgrid | mailchannels | none
}
